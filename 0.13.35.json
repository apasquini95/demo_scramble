{
    "openapi": "3.1.0",
    "info": {
        "title": "Laravel",
        "version": "0.0.1"
    },
    "servers": [
        {
            "url": "http://localhost/api"
        }
    ],
    "paths": {
        "/my-model/{myModel}": {
            "get": {
                "operationId": "myModel",
                "tags": [
                    "My"
                ],
                "parameters": [
                    {
                        "name": "myModel",
                        "in": "path",
                        "required": true,
                        "description": "The my model ID",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "`MyModelResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/MyModelResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/ModelNotFoundException"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "MyModelResource": {
                "type": "object",
                "properties": {
                    "datetimeProp": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "dateProp": {
                        "type": "string",
                        "format": "date"
                    }
                },
                "required": [
                    "datetimeProp",
                    "dateProp"
                ],
                "title": "MyModelResource"
            }
        },
        "responses": {
            "ModelNotFoundException": {
                "description": "Not found",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            }
        }
    }
}